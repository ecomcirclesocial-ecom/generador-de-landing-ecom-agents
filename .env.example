# Copia este archivo como .env.local y pega tus datos ahí.
# .env.local NO se sube a git (está en .gitignore).

# Las claves también se pueden poner desde la web, en Configuraciones.
# Lo que guardes ahí (data/config.json) manda sobre lo que pongas en este archivo.

# Google Gemini — motor de imágenes Nano Banana.
# Saca tu key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI — solo si eliges ChatGPT como motor de imágenes (gpt-image).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Tu tienda Shopify, para publicar las landings (ej. mitienda.myshopify.com).
# La autenticación vive en el CLI de Shopify (shopify store auth), aquí solo el dominio.
SHOPIFY_STORE_DOMAIN=

# NO pongas ANTHROPIC_API_KEY.
# El texto lo escribe Claude Code con tu suscripción, no con la API.
# Si pones la key aquí, empezaría a cobrarte por API en vez de usar tu plan.
